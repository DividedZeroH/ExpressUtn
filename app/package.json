{
  "name": "bar",
  "version": "1.0.0",
  "description": "Sistema de gestión de bar — bebidas, barras y ventas",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev-start": "docker compose up -d --wait db && node --watch src/app.js",
    "setup": "npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@adminjs/design-system": "^3.0.0",
    "@adminjs/express": "^6.1.0",
    "@adminjs/sequelize": "^4.1.1",
    "adminjs": "^7.8.13",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.17.3",
    "mongoose": "^8.24.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sequelize": "^6.35.2",
    "styled-components": "^5.3.6"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
