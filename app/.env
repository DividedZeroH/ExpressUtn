# .env (para ejecución local/nativa en Windows)

# Driver de la capa repository: sequelize | drizzle (ambos Postgres) | mongoose (MongoDB)
DB_DRIVER=sequelize
# Conexión a MongoDB (solo se usa si DB_DRIVER=mongoose)
MONGO_URI=mongodb://localhost:27017/bar
# Drizzle reusa las mismas variables POSTGRES_* de abajo (misma base que Sequelize).

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bar_db
POSTGRES_USER=bar_user
POSTGRES_PASSWORD=secure_local_password_99
LANG=es_AR.utf8
ADMIN_EMAIL=admin@barexpress.utn
ADMIN_PASSWORD=admin_utn_pass_123
PORT=3000
